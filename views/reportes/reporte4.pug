extends ../__layout/main

block content
  .container.mt-4
    .d-flex.align-items-center.mb-4.gap-3
      a.btn.btn-outline-secondary(href='/reportes')
        i.bi.bi-arrow-left.me-1
        | Volver
      h2.fw-bold.mb-0
        i.bi.bi-bar-chart-line.me-2.text-primary
        | Reporte 4 — Aplicaciones con Vacuna Vencida

    .alert.alert-danger.mb-4
      i.bi.bi-exclamation-triangle-fill.me-2
      | Este reporte lista personas a las que se aplicó una vacuna cuyo lote ya había vencido al momento de la aplicación.

    //- Indicador de ubicación filtrada (sin dropdown)
    if !alcance.esNC && !alcance.mostrarSelector && alcance.ubicacionSeleccionada
      .alert.alert-light.border.py-2.mb-3
        i.bi.bi-geo-alt-fill.me-2.text-primary
        | Mostrando datos de:&nbsp;
        strong
          - var ubi = alcance.ubicacionesDisponibles.find(u => u.id === alcance.ubicacionSeleccionada)
          if ubi
            = ubi.nombre

    //- Dropdown cuando tiene varias ubicaciones
    if alcance.mostrarSelector
      .card.mb-4
        .card-header.bg-primary.text-white
          i.bi.bi-funnel.me-2
          | Filtros
        .card-body
          form(method='GET' action='/reportes/4')
            .row.g-3.align-items-end
              .col-md-6
                .form-floating
                  select.form-select#ubicacion(name='ubicacion')
                    each u in alcance.ubicacionesDisponibles
                      option(value=u.id selected=(u.id === alcance.ubicacionSeleccionada))= u.nombre
                  label(for='ubicacion') Ubicación
              .col-md-3
                button.btn.btn-primary.w-100(type='submit')
                  i.bi.bi-arrow-clockwise.me-2
                  | Actualizar

    if resultados.length === 0
      .alert.alert-success
        i.bi.bi-check-circle.me-2
        | No se registraron aplicaciones con vacunas vencidas.
    else
      .card
        .card-header.bg-danger.text-white
          strong Total de casos: #{resultados.length}
        .table-responsive
          table#tablaReporte.table.table-striped.table-hover.align-middle.mb-0
            thead.table-dark
              tr
                th Paciente
                th DNI
                th Provincia
                th Centro
                th Tipo Vacuna
                th Fecha Aplicación
                th Fecha Vencimiento Lote
            tbody
              each r in resultados
                tr.table-danger
                  td= `${r.apellido_paciente}, ${r.nombre_paciente}`
                  td= r.dni
                  td= r.provincia || '—'
                  td= r.centro
                  td
                    span.badge.bg-dark= r.tipo_vacuna
                  td= r.fecha_aplicacion
                  td
                    span.text-danger.fw-bold= r.fecha_vencimiento_lote

block scripts
  link(rel='stylesheet' href='https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.min.css')
  script(src='https://cdn.datatables.net/2.1.8/js/dataTables.min.js')
  script(src='https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.min.js')
  script.
    $(function () {
      if ($('#tablaReporte').length) {
        $('#tablaReporte').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/2.1.8/i18n/es-ES.json' },
          pageLength: 25,
          order: []
        });
      }
      $('#ubicacion').select2({ width: '100%', dropdownParent: $('#ubicacion').parent() });
    });
