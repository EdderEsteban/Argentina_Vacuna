nav.navbar.navbar-expand.navbar-dark.bg-primary.fixed-top.shadow-sm
  .container-fluid.px-3
    //- Botón hamburger
    button.btn.p-1.text-white.me-2#btnSidebar(type='button')
      i.bi.bi-list(style='font-size:1.5rem')

    //- Brand (visible en desktop, donde el sidebar ya está abierto)
    a.navbar-brand-name.d-none.d-lg-flex(href='/dashboard')
      i.bi.bi-shield-check
      | Argentina Vacuna

    span.flex-grow-1

    //- Dropdown del usuario
    ul.navbar-nav.align-items-center.flex-row
      li.nav-item.dropdown
        a.nav-link.dropdown-toggle.d-flex.align-items-center.gap-1.py-2(href='#' data-bs-toggle='dropdown')
          i.bi.bi-person-circle(style='font-size:1.2rem')
          span.d-none.d-sm-inline.ms-1 #{usuario.nombre} #{usuario.apellido}
          span.badge.ms-2.small(style='background:rgba(255,255,255,0.18);color:#fff')= usuario.rol
          if usuario.ubicacionActual
            span.badge.bg-success.ms-1.small.d-none.d-xl-inline
              i.bi.bi-geo-alt-fill.me-1
              = usuario.ubicacionActual.nombre
        ul.dropdown-menu.dropdown-menu-end.shadow
          li.px-3.py-2
            div.fw-semibold= `${usuario.nombre} ${usuario.apellido}`
            div.text-muted.small
              i.bi.bi-person.me-1
              = usuario.usuario
            if usuario.ubicacionActual
              div.text-success.small.mt-1
                i.bi.bi-geo-alt-fill.me-1
                = usuario.ubicacionActual.nombre
          li: hr.dropdown-divider
          li
            a.dropdown-item(href='/mi-cuenta')
              i.bi.bi-person-gear.me-2
              | Mi cuenta
          if usuario.rol === 'Administrador' && usuario.ubicaciones && usuario.ubicaciones.length > 1
            li
              a.dropdown-item(href='/seleccionar-ubicacion')
                i.bi.bi-arrow-repeat.me-2
                | Cambiar ubicación
          li: hr.dropdown-divider
          li
            a.dropdown-item.text-danger(href='/logout')
              i.bi.bi-box-arrow-right.me-2
              | Cerrar sesión
