extends ../__layout/main

block content
  .container.mt-4
    .row.justify-content-center
      .col-lg-8

        .card.form-card
          .form-card-header
            i.bi.bi-box-seam
            h5 Nuevo Lote

          .card-body.form-card-body
            form#formNuevoLote
              input(type="hidden" name="_csrf" value=csrfToken)

              p.form-section-label
                i.bi.bi-hash.me-2
                | Identificación del lote
              .row.g-3.mb-4
                .col-md-6
                  .form-floating
                    input.form-control(
                      type="text"
                      id="numLote"
                      name="numLote"
                      required
                      placeholder=""
                    )
                    label(for="numLote") N° Lote
                  small.form-text.text-muted Mínimo 3 caracteres, máximo 100
                .col-md-6
                  .form-floating
                    select.form-select(
                      id="id_laboratorio"
                      name="id_laboratorio"
                      required
                    )
                      option(value="" disabled selected) -- Seleccione --
                      each laboratorio in laboratorios
                        option(value=laboratorio.id)= laboratorio.nombre
                    label(for="id_laboratorio") Laboratorio
                .col-md-6
                  .form-floating
                    input.form-control(
                      type="number"
                      id="cantidad"
                      name="cantidad"
                      min="1"
                      required
                      placeholder="0"
                    )
                    label(for="cantidad") Cantidad de dosis
                .col-md-6
                  .form-floating
                    input.form-control(
                      type="text"
                      id="pais_origen"
                      name="pais_origen"
                      required
                      placeholder=""
                      maxlength="100"
                    )
                    label(for="pais_origen") País de Origen

              p.form-section-label
                i.bi.bi-capsule.me-2
                | Información de la vacuna
              .row.g-3.mb-4
                .col-md-6
                  .form-floating
                    input.form-control(
                      type="text"
                      id="tipo_vacuna"
                      name="tipo_vacuna"
                      required
                      placeholder=""
                    )
                    label(for="tipo_vacuna") Tipo de Vacuna
                .col-md-6
                  .form-floating
                    input.form-control(
                      type="text"
                      id="nombre_comercial"
                      name="nombre_comercial"
                      required
                      placeholder=""
                    )
                    label(for="nombre_comercial") Nombre Comercial y Presentación

              p.form-section-label
                i.bi.bi-calendar3.me-2
                | Fechas
              .row.g-3.mb-4
                .col-md-3.col-sm-6
                  .form-floating
                    input.form-control(
                      type="date"
                      id="fecha_fab"
                      name="fecha_fab"
                      required
                      placeholder=""
                    )
                    label(for="fecha_fab") Fabricación
                .col-md-3.col-sm-6
                  .form-floating
                    input.form-control(
                      type="date"
                      id="fecha_venc"
                      name="fecha_venc"
                      required
                      placeholder=""
                    )
                    label(for="fecha_venc") Vencimiento
                .col-md-3.col-sm-6
                  .form-floating
                    input.form-control(
                      type="date"
                      id="fecha_compra"
                      name="fecha_compra"
                      required
                      placeholder=""
                    )
                    label(for="fecha_compra") Compra
                .col-md-3.col-sm-6
                  .form-floating
                    input.form-control(
                      type="date"
                      id="fecha_adquisicion"
                      name="fecha_adquisicion"
                      required
                      placeholder=""
                    )
                    label(for="fecha_adquisicion") Adquisición

              .d-flex.gap-2.pt-2.border-top.mt-2
                button.btn.btn-primary(type="button" id="guardarNuevoLote")
                  i.bi.bi-save.me-2
                  | Guardar Lote
                a.btn.btn-outline-secondary(type="button" id="cancelarNuevoLote")
                  i.bi.bi-x-circle.me-2
                  | Cancelar

  script(src="/js/lote/nuevoLote.js")
